[
 {
  "kind": "sec",
  "t": 1.0,
  "text": "0:00 말 못 한 장면 (약 45초)"
 },
 {
  "kind": "line",
  "t": 1.0,
  "dur": 3.2972916666666667,
  "text": "지난주 화요일, 공사장 옆을 지나고 있었다."
 },
 {
  "kind": "line",
  "t": 4.747291666666667,
  "dur": 3.3977083333333336,
  "text": "휴대폰을 보며 걷는데, 머리 위에서 뭔가 떨어졌다."
 },
 {
  "kind": "line",
  "t": 8.595,
  "dur": 0.8049166666666666,
  "text": "벽돌이었다."
 },
 {
  "kind": "line",
  "t": 9.849916666666667,
  "dur": 3.058291666666667,
  "text": "내 발끝 한 뼘 앞에서, 산산조각이 났다."
 },
 {
  "kind": "line",
  "t": 14.358208333333334,
  "dur": 1.5343541666666667,
  "text": "한 걸음만 빨랐다면."
 },
 {
  "kind": "line",
  "t": 16.3425625,
  "dur": 3.8023541666666665,
  "text": "위에서 인부가 소리쳤고, 나는 괜찮다고 손을 흔들었다."
 },
 {
  "kind": "line",
  "t": 20.594916666666666,
  "dur": 3.1075,
  "text": "그리고 아무 일 없었다는 듯, 회사에 갔다."
 },
 {
  "kind": "line",
  "t": 24.152416666666667,
  "dur": 2.8323125,
  "text": "엄마한테는 말하지 않았다. 걱정할까 봐."
 },
 {
  "kind": "line",
  "t": 27.434729166666667,
  "dur": 3.5180625,
  "text": "그런데 그날 밤, 이상한 생각이 떠나지 않았다."
 },
 {
  "kind": "line",
  "t": 31.402791666666666,
  "dur": 3.3431041666666665,
  "text": "한 걸음 빨랐던 나는, 지금 어디에 있을까."
 },
 {
  "kind": "sec",
  "t": 41.19589583333333,
  "text": "0:45 두 번 살아남은 남자 (약 1분)"
 },
 {
  "kind": "line",
  "t": 41.19589583333333,
  "dur": 2.9626041666666665,
  "text": "1945년 8월 6일, 히로시마."
 },
 {
  "kind": "line",
  "t": 44.6085,
  "dur": 10.665916666666666,
  "text": "출장을 와 있던 스물아홉 살의 조선소 기술자, 야마구치 쓰토무는 그날 아침, 원자폭탄이 터진 곳에서 3킬로미터도 떨어지지 않은 곳에 있었다."
 },
 {
  "kind": "line",
  "t": 55.72441666666666,
  "dur": 6.254708333333333,
  "text": "그는 상반신에 큰 화상을 입고, 그곳에서 하룻밤을 보낸 뒤, 고향 나가사키로 돌아갔다."
 },
 {
  "kind": "line",
  "t": 62.429125,
  "dur": 2.3004583333333333,
  "text": "그리고 사흘 뒤, 8월 9일."
 },
 {
  "kind": "line",
  "t": 65.17958333333333,
  "dur": 3.3295625,
  "text": "나가사키에, 두 번째 원자폭탄이 떨어졌다."
 },
 {
  "kind": "line",
  "t": 68.95914583333332,
  "dur": 3.1751875,
  "text": "그는 그때도, 폭심지에서 3킬로미터 안에 있었다."
 },
 {
  "kind": "line",
  "t": 72.58433333333332,
  "dur": 1.67275,
  "text": "그리고, 살아남았다."
 },
 {
  "kind": "line",
  "t": 74.70708333333332,
  "dur": 7.473291666666666,
  "text": "그는 2009년에야 두 도시 모두의 피폭자로 공식 인정을 받았고, 이듬해 아흔셋의 나이로 세상을 떠났다."
 },
 {
  "kind": "line",
  "t": 82.63037499999999,
  "dur": 4.886541666666667,
  "text": "그날 세상을 떠난 수많은 사람들을 생각하면, 이건 가벼운 질문이 아니다."
 },
 {
  "kind": "line",
  "t": 87.96691666666665,
  "dur": 1.4414583333333333,
  "text": "그래도 묻게 된다."
 },
 {
  "kind": "line",
  "t": 89.85837499999998,
  "dur": 1.1300833333333333,
  "text": "왜 그였을까."
 },
 {
  "kind": "line",
  "t": 91.43845833333332,
  "dur": 0.90825,
  "text": "운이었을까."
 },
 {
  "kind": "line",
  "t": 92.79670833333331,
  "dur": 3.6639791666666666,
  "text": "아니면, 그가 살아남은 세계만이, 우리에게 보이는 걸까."
 },
 {
  "kind": "sec",
  "t": 98.31068749999999,
  "text": "1:45 세계가 갈라진다 (약 1분)"
 },
 {
  "kind": "line",
  "t": 98.31068749999999,
  "dur": 5.494875,
  "text": "1957년, 프린스턴의 대학원생 휴 에버렛은 이상한 논문 한 편을 냈다."
 },
 {
  "kind": "line",
  "t": 104.25556249999998,
  "dur": 12.3563125,
  "text": "양자의 세계에서, 아주 작은 입자는 여러 가능성에 걸쳐 있다. 그리고 누군가 들여다보는 순간, 그중 하나로 정해진다. 그게 당시의 정설이었다."
 },
 {
  "kind": "line",
  "t": 117.06187499999999,
  "dur": 1.7565625,
  "text": "에버렛은 반대로 말했다."
 },
 {
  "kind": "line",
  "t": 119.26843749999999,
  "dur": 6.739375,
  "text": "정해지는 게 아니다. 모든 가능성이, 다 일어난다. 다만 세계가 갈라질 뿐이다."
 },
 {
  "kind": "line",
  "t": 126.45781249999999,
  "dur": 3.9241875,
  "text": "원자 하나가 붕괴하는 세계와, 붕괴하지 않는 세계."
 },
 {
  "kind": "line",
  "t": 130.832,
  "dur": 3.3359375,
  "text": "벽돌에 맞은 세계와, 한 뼘 앞에서 깨진 세계."
 },
 {
  "kind": "line",
  "t": 134.61793749999998,
  "dur": 1.7133125,
  "text": "이른바, 다세계 해석."
 },
 {
  "kind": "line",
  "t": 136.78124999999997,
  "dur": 3.8138125,
  "text": "지금도 물리학자들 사이에서 논쟁이 끝나지 않은 해석이다."
 },
 {
  "kind": "line",
  "t": 141.04506249999997,
  "dur": 4.575020833333333,
  "text": "그런데 이 해석에는, 아무도 원하지 않았던 질문 하나가 따라붙었다."
 }
]