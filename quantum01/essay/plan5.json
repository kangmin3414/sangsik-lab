[
 {
  "kind": "sec",
  "t": 0.8,
  "text": "0:00 말 못 한 장면"
 },
 {
  "kind": "line",
  "t": 0.8,
  "dur": 2.867208333333333,
  "text": "지난주 화요일, 공사장 옆을 지나고 있었다."
 },
 {
  "kind": "line",
  "t": 4.0172083333333335,
  "dur": 2.9545208333333335,
  "text": "휴대폰을 보며 걷는데, 머리 위에서 뭔가 떨어졌다."
 },
 {
  "kind": "line",
  "t": 7.3217291666666675,
  "dur": 0.6999375,
  "text": "벽돌이었다."
 },
 {
  "kind": "line",
  "t": 8.371666666666668,
  "dur": 2.659375,
  "text": "내 발끝 한 뼘 앞에서, 산산조각이 났다."
 },
 {
  "kind": "line",
  "t": 12.381041666666668,
  "dur": 1.3342291666666666,
  "text": "한 걸음만 빨랐다면."
 },
 {
  "kind": "line",
  "t": 14.065270833333335,
  "dur": 3.6714375,
  "text": "나는 괜찮다고 손을 흔들고, 아무 일 없었다는 듯 회사에 갔다."
 },
 {
  "kind": "line",
  "t": 18.086708333333334,
  "dur": 2.462875,
  "text": "엄마한테는 말하지 않았다. 걱정할까 봐."
 },
 {
  "kind": "line",
  "t": 20.899583333333332,
  "dur": 2.62325,
  "text": "그런데 그날 밤, 이 생각이 떠나지 않았다."
 },
 {
  "kind": "line",
  "t": 23.872833333333332,
  "dur": 2.9070416666666667,
  "text": "한 걸음 빨랐던 나는, 지금 어디에 있을까."
 },
 {
  "kind": "sec",
  "t": 32.129875,
  "text": "0:35 두 번 살아남은 남자"
 },
 {
  "kind": "line",
  "t": 32.129875,
  "dur": 2.5761875,
  "text": "1945년 8월 6일, 히로시마."
 },
 {
  "kind": "line",
  "t": 35.056062499999996,
  "dur": 6.746291666666667,
  "text": "출장 중이던 기술자 야마구치 쓰토무는, 원자폭탄이 터진 곳에서 3킬로미터도 떨어지지 않은 곳에 있었다."
 },
 {
  "kind": "line",
  "t": 42.15235416666666,
  "dur": 5.115125,
  "text": "화상을 입고 고향 나가사키로 돌아간 그는, 사흘 뒤, 두 번째 원자폭탄을 만났다."
 },
 {
  "kind": "line",
  "t": 47.61747916666666,
  "dur": 2.3737083333333335,
  "text": "이번에도, 3킬로미터 안쪽이었다."
 },
 {
  "kind": "line",
  "t": 50.3411875,
  "dur": 2.2305208333333333,
  "text": "그리고 살아남았다. 아흔셋까지."
 },
 {
  "kind": "line",
  "t": 52.92170833333333,
  "dur": 5.378666666666667,
  "text": "그날 떠난 수많은 사람들을 생각하면, 가벼운 질문이 아니다. 그래도 묻게 된다."
 },
 {
  "kind": "line",
  "t": 58.650375,
  "dur": 2.2555833333333335,
  "text": "왜 그였을까. 운이었을까."
 },
 {
  "kind": "line",
  "t": 61.25595833333333,
  "dur": 3.1860625,
  "text": "아니면, 그가 살아남은 세계만이, 우리에게 보이는 걸까."
 },
 {
  "kind": "sec",
  "t": 65.79202083333334,
  "text": "1:15 세계가 갈라진다"
 },
 {
  "kind": "line",
  "t": 65.79202083333334,
  "dur": 4.1133125,
  "text": "1957년, 대학원생 휴 에버렛은 이상한 주장을 했다."
 },
 {
  "kind": "line",
  "t": 70.25533333333334,
  "dur": 6.0468125,
  "text": "아주 작은 입자의 세계에서, 가능성은 하나로 정해지지 않는다. 모두 일어나고, 세계가 갈라질 뿐이다."
 },
 {
  "kind": "line",
  "t": 76.65214583333334,
  "dur": 2.9008125,
  "text": "벽돌에 맞은 세계와, 한 뼘 앞에서 깨진 세계."
 },
 {
  "kind": "line",
  "t": 79.90295833333333,
  "dur": 3.9047083333333332,
  "text": "이른바 다세계 해석. 지금도 논쟁이 끝나지 않은 해석이다."
 },
 {
  "kind": "line",
  "t": 84.15766666666667,
  "dur": 2.9507708333333333,
  "text": "그리고 여기에, 섬뜩한 질문 하나가 따라붙었다."
 },
 {
  "kind": "sec",
  "t": 88.4584375,
  "text": "1:45 양자 불멸"
 },
 {
  "kind": "line",
  "t": 88.4584375,
  "dur": 3.363770833333333,
  "text": "벽돌에 맞은 세계의 나는, 아무것도 느낄 수 없다."
 },
 {
  "kind": "line",
  "t": 92.17220833333333,
  "dur": 3.3143541666666665,
  "text": "느낄 수 있는 나는, 언제나 살아남은 쪽에 있다."
 },
 {
  "kind": "line",
  "t": 95.8365625,
  "dur": 4.700020833333333,
  "text": "계단에서 미끄러질 때도, 비행기가 흔들릴 때도, 심장이 멈칫할 때도."
 },
 {
  "kind": "line",
  "t": 100.88658333333333,
  "dur": 4.7878541666666665,
  "text": "남들이 보기에 나는 어느 날 죽지만, 내 눈으로 보면, 한 번도 죽은 적이 없다."
 },
 {
  "kind": "line",
  "t": 106.0244375,
  "dur": 4.7977083333333335,
  "text": "물리학자 맥스 테그마크가 널리 알린 이 사고실험의 이름은, 양자 불멸."
 },
 {
  "kind": "line",
  "t": 112.17214583333333,
  "dur": 2.2944375,
  "text": "나는, 절대 죽을 수 없다."
 },
 {
  "kind": "line",
  "t": 114.81658333333333,
  "dur": 2.2335625,
  "text": "처음엔, 그 말이 축복처럼 들렸다."
 },
 {
  "kind": "sec",
  "t": 118.40014583333333,
  "text": "2:25 꺼지지 않는 생일"
 },
 {
  "kind": "line",
  "t": 118.40014583333333,
  "dur": 7.9906875,
  "text": "기록상 가장 오래 산 사람, 프랑스의 잔 칼망은 122세에 눈을 감았다. 어린 시절, 반 고흐를 직접 봤던 사람이다."
 },
 {
  "kind": "line",
  "t": 126.74083333333333,
  "dur": 4.393833333333333,
  "text": "하지만 양자 불멸이 맞다면, 122세는 끝이 아니라 시작이다."
 },
 {
  "kind": "line",
  "t": 131.48466666666667,
  "dur": 4.025229166666667,
  "text": "이백 살. 내 이름을 기억하는 사람이, 없다."
 },
 {
  "kind": "line",
  "t": 135.85989583333333,
  "dur": 3.5062291666666665,
  "text": "삼백 살. 숨은, 기계가 대신 쉰다."
 },
 {
  "kind": "line",
  "t": 139.716125,
  "dur": 3.311125,
  "text": "몸은 망가져 가는데, 꺼지는 세계로는 갈 수가 없다."
 },
 {
  "kind": "line",
  "t": 143.37725,
  "dur": 3.6076041666666665,
  "text": "천 살. 말을 걸어도, 알아듣는 사람이 없다."
 },
 {
  "kind": "line",
  "t": 147.33485416666667,
  "dur": 6.484375,
  "text": "오십억 년 뒤, 태양이 부풀어 오른다. 그래도 나는, 어딘가에서, 아직 깨어 있다."
 },
 {
  "kind": "line",
  "t": 154.16922916666667,
  "dur": 2.4213958333333334,
  "text": "끝이 없다는 건, 축복이 아니었다."
 },
 {
  "kind": "line",
  "t": 157.74062500000002,
  "dur": 1.5662916666666666,
  "text": "끝이, 없다."
 },
 {
  "kind": "sec",
  "t": 162.6569166666667,
  "text": "3:20 반전"
 },
 {
  "kind": "line",
  "t": 162.6569166666667,
  "dur": 3.237229166666667,
  "text": "그런데, 이 생각을 널리 알린 테그마크 자신은 이렇게 봤다."
 },
 {
  "kind": "line",
  "t": 166.24414583333336,
  "dur": 6.380770833333333,
  "text": "죽음은 스위치처럼 딱 꺼지지 않는다. 해가 지듯, 천천히 흐려진다."
 },
 {
  "kind": "line",
  "t": 172.9749166666667,
  "dur": 2.923125,
  "text": "그래서 이 함정은, 현실에서 맞아떨어지지 않는다고."
 },
 {
  "kind": "line",
  "t": 176.2480416666667,
  "dur": 6.615479166666667,
  "text": "이건 증명된 이론이 아니라, 상상으로만 남은 실험이다. 누구도, 절대 직접 시험해서는 안 된다."
 },
 {
  "kind": "line",
  "t": 183.21352083333335,
  "dur": 2.408625,
  "text": "그리고 내가 놓친 게, 하나 더 있었다."
 },
 {
  "kind": "line",
  "t": 185.97214583333334,
  "dur": 4.2105625,
  "text": "벽돌에 맞은 그 세계에서도, 시간은 흐른다. 내가 없는 채로."
 },
 {
  "kind": "line",
  "t": 190.53270833333335,
  "dur": 3.4414166666666666,
  "text": "엄마의 휴대폰에 내 이름이 뜨고, 받는 사람이 없다."
 },
 {
  "kind": "line",
  "t": 194.324125,
  "dur": 2.8097083333333335,
  "text": "그 세계에는, 나를 잃은 사람들이 살고 있었다."
 },
 {
  "kind": "sec",
  "t": 198.48383333333334,
  "text": "4:00 반대편에 선 사람에게"
 },
 {
  "kind": "line",
  "t": 198.48383333333334,
  "dur": 5.529916666666667,
  "text": "어쩌면 이 영상을 보는 누군가는, 그 반대편에 서 있을지도 모른다. 누군가를 먼저 보낸 쪽에."
 },
 {
  "kind": "line",
  "t": 204.36375,
  "dur": 7.247416666666667,
  "text": "그렇다면 이렇게 상상해 봐도 좋겠다. 수많은 갈래 어딘가에서, 그 사람이 아직 웃고 있다고."
 },
 {
  "kind": "line",
  "t": 211.96116666666668,
  "dur": 4.1076875,
  "text": "증명할 수는 없다. 그래도 위로가 된다면, 그걸로 충분하다."
 },
 {
  "kind": "line",
  "t": 216.41885416666668,
  "dur": 3.5700625,
  "text": "그리고 이 세계에 남은 사람들은, 아직 전화를 받는다."
 },
 {
  "kind": "sec",
  "t": 221.33891666666668,
  "text": "4:25 해소"
 },
 {
  "kind": "line",
  "t": 221.33891666666668,
  "dur": 1.6545625,
  "text": "다시, 화요일의 공사장."
 },
 {
  "kind": "line",
  "t": 223.34347916666667,
  "dur": 1.7531041666666667,
  "text": "아무 일 없었던 게, 아니었다."
 },
 {
  "kind": "line",
  "t": 225.44658333333334,
  "dur": 2.9303541666666666,
  "text": "오늘 아침 눈을 뜬 것도, 당연한 일이 아니었다."
 },
 {
  "kind": "line",
  "t": 228.7269375,
  "dur": 3.238020833333333,
  "text": "그 많은 갈림길 끝에, 하필 이 세계에서 깬 거니까."
 },
 {
  "kind": "line",
  "t": 232.31495833333332,
  "dur": 8.7211875,
  "text": "2008년 심리학자 제이미 커츠의 실험에서, 졸업이 곧이라고 생각한 대학생들은, 아직 멀었다고 생각한 학생들보다 하고 싶던 일을 더 많이 해냈다."
 },
 {
  "kind": "line",
  "t": 241.38614583333333,
  "dur": 2.5794791666666668,
  "text": "끝을 떠올리면, 지금이 진해진다."
 },
 {
  "kind": "line",
  "t": 244.315625,
  "dur": 6.9699375,
  "text": "끝이 있어서, 미루지 않는다. 끝이 있어서, 지금 말한다. 끝이 있어서, 오늘이다."
 },
 {
  "kind": "line",
  "t": 251.63556250000002,
  "dur": 3.1419791666666668,
  "text": "다음 날 점심, 엄마한테 먼저 전화를 걸었다."
 },
 {
  "kind": "line",
  "t": 255.12754166666667,
  "dur": 4.547541666666667,
  "text": "웬일이냐고, 엄마가 웃었다. 그냥. 목소리 듣고 싶어서."
 },
 {
  "kind": "line",
  "t": 261.0250833333333,
  "dur": 2.0221458333333335,
  "text": "나는, 언제든 끝날 수 있다."
 },
 {
  "kind": "line",
  "t": 263.39722916666665,
  "dur": 1.9389166666666666,
  "text": "그래서 오늘이, 진짜다."
 }
]