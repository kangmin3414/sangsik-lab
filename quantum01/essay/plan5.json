[
 {
  "kind": "sec",
  "t": 0.8,
  "text": "0:00 말 못 한 장면"
 },
 {
  "kind": "line",
  "t": 0.8,
  "dur": 3.2972916666666667,
  "text": "지난주 화요일, 공사장 옆을 지나고 있었다."
 },
 {
  "kind": "line",
  "t": 4.4972916666666665,
  "dur": 3.3977083333333336,
  "text": "휴대폰을 보며 걷는데, 머리 위에서 뭔가 떨어졌다."
 },
 {
  "kind": "line",
  "t": 8.295,
  "dur": 0.8049166666666666,
  "text": "벽돌이었다."
 },
 {
  "kind": "line",
  "t": 9.499916666666667,
  "dur": 3.058291666666667,
  "text": "내 발끝 한 뼘 앞에서, 산산조각이 났다."
 },
 {
  "kind": "line",
  "t": 13.958208333333335,
  "dur": 1.5343541666666667,
  "text": "한 걸음만 빨랐다면."
 },
 {
  "kind": "line",
  "t": 15.892562500000002,
  "dur": 4.222145833333333,
  "text": "나는 괜찮다고 손을 흔들고, 아무 일 없었다는 듯 회사에 갔다."
 },
 {
  "kind": "line",
  "t": 20.514708333333335,
  "dur": 2.8323125,
  "text": "엄마한테는 말하지 않았다. 걱정할까 봐."
 },
 {
  "kind": "line",
  "t": 23.747020833333334,
  "dur": 3.0167291666666665,
  "text": "그런데 그날 밤, 이 생각이 떠나지 않았다."
 },
 {
  "kind": "line",
  "t": 27.16375,
  "dur": 3.3431041666666665,
  "text": "한 걸음 빨랐던 나는, 지금 어디에 있을까."
 },
 {
  "kind": "sec",
  "t": 36.00685416666666,
  "text": "0:35 두 번 살아남은 남자"
 },
 {
  "kind": "line",
  "t": 36.00685416666666,
  "dur": 2.9626041666666665,
  "text": "1945년 8월 6일, 히로시마."
 },
 {
  "kind": "line",
  "t": 39.36945833333333,
  "dur": 7.758229166666666,
  "text": "출장 중이던 기술자 야마구치 쓰토무는, 원자폭탄이 터진 곳에서 3킬로미터도 떨어지지 않은 곳에 있었다."
 },
 {
  "kind": "line",
  "t": 47.52768749999999,
  "dur": 5.882395833333334,
  "text": "화상을 입고 고향 나가사키로 돌아간 그는, 사흘 뒤, 두 번째 원자폭탄을 만났다."
 },
 {
  "kind": "line",
  "t": 53.810083333333324,
  "dur": 2.7297708333333333,
  "text": "이번에도, 3킬로미터 안쪽이었다."
 },
 {
  "kind": "line",
  "t": 56.939854166666656,
  "dur": 2.5651041666666665,
  "text": "그리고 살아남았다. 아흔셋까지."
 },
 {
  "kind": "line",
  "t": 59.904958333333326,
  "dur": 6.185458333333333,
  "text": "그날 떠난 수많은 사람들을 생각하면, 가벼운 질문이 아니다. 그래도 묻게 된다."
 },
 {
  "kind": "line",
  "t": 66.49041666666666,
  "dur": 2.593916666666667,
  "text": "왜 그였을까. 운이었을까."
 },
 {
  "kind": "line",
  "t": 69.48433333333332,
  "dur": 3.6639791666666666,
  "text": "아니면, 그가 살아남은 세계만이, 우리에게 보이는 걸까."
 },
 {
  "kind": "sec",
  "t": 74.64831249999999,
  "text": "1:15 세계가 갈라진다"
 },
 {
  "kind": "line",
  "t": 74.64831249999999,
  "dur": 4.7303125,
  "text": "1957년, 대학원생 휴 에버렛은 이상한 주장을 했다."
 },
 {
  "kind": "line",
  "t": 79.77862499999999,
  "dur": 6.953833333333334,
  "text": "아주 작은 입자의 세계에서, 가능성은 하나로 정해지지 않는다. 모두 일어나고, 세계가 갈라질 뿐이다."
 },
 {
  "kind": "line",
  "t": 87.13245833333332,
  "dur": 3.3359375,
  "text": "벽돌에 맞은 세계와, 한 뼘 앞에서 깨진 세계."
 },
 {
  "kind": "line",
  "t": 90.86839583333332,
  "dur": 4.4904166666666665,
  "text": "이른바 다세계 해석. 지금도 논쟁이 끝나지 않은 해석이다."
 },
 {
  "kind": "line",
  "t": 95.75881249999999,
  "dur": 3.3933958333333334,
  "text": "그리고 여기에, 섬뜩한 질문 하나가 따라붙었다."
 },
 {
  "kind": "sec",
  "t": 100.65220833333332,
  "text": "1:45 양자 불멸"
 },
 {
  "kind": "line",
  "t": 100.65220833333332,
  "dur": 3.868333333333333,
  "text": "벽돌에 맞은 세계의 나는, 아무것도 느낄 수 없다."
 },
 {
  "kind": "line",
  "t": 104.92054166666665,
  "dur": 3.8115,
  "text": "느낄 수 있는 나는, 언제나 살아남은 쪽에 있다."
 },
 {
  "kind": "line",
  "t": 109.13204166666665,
  "dur": 5.405020833333333,
  "text": "계단에서 미끄러질 때도, 비행기가 흔들릴 때도, 심장이 멈칫할 때도."
 },
 {
  "kind": "line",
  "t": 114.93706249999998,
  "dur": 5.506020833333333,
  "text": "남들이 보기에 나는 어느 날 죽지만, 내 눈으로 보면, 한 번도 죽은 적이 없다."
 },
 {
  "kind": "line",
  "t": 120.84308333333331,
  "dur": 5.517375,
  "text": "물리학자 맥스 테그마크가 널리 알린 이 사고실험의 이름은, 양자 불멸."
 },
 {
  "kind": "line",
  "t": 127.76045833333332,
  "dur": 2.6386041666666666,
  "text": "나는, 절대 죽을 수 없다."
 },
 {
  "kind": "line",
  "t": 130.7990625,
  "dur": 2.568604166666667,
  "text": "처음엔, 그 말이 축복처럼 들렸다."
 },
 {
  "kind": "sec",
  "t": 134.86766666666665,
  "text": "2:25 꺼지지 않는 생일"
 },
 {
  "kind": "line",
  "t": 134.86766666666665,
  "dur": 9.189291666666668,
  "text": "기록상 가장 오래 산 사람, 프랑스의 잔 칼망은 122세에 눈을 감았다. 어린 시절, 반 고흐를 직접 봤던 사람이다."
 },
 {
  "kind": "line",
  "t": 144.45695833333332,
  "dur": 5.0529166666666665,
  "text": "하지만 양자 불멸이 맞다면, 122세는 끝이 아니라 시작이다."
 },
 {
  "kind": "line",
  "t": 149.909875,
  "dur": 4.629020833333334,
  "text": "이백 살. 내 이름을 기억하는 사람이, 없다."
 },
 {
  "kind": "line",
  "t": 154.93889583333333,
  "dur": 4.032166666666667,
  "text": "삼백 살. 숨은, 기계가 대신 쉰다."
 },
 {
  "kind": "line",
  "t": 159.3710625,
  "dur": 3.8077916666666667,
  "text": "몸은 망가져 가는데, 꺼지는 세계로는 갈 수가 없다."
 },
 {
  "kind": "line",
  "t": 163.57885416666667,
  "dur": 4.14875,
  "text": "천 살. 말을 걸어도, 알아듣는 사람이 없다."
 },
 {
  "kind": "line",
  "t": 168.12760416666669,
  "dur": 7.457020833333333,
  "text": "오십억 년 뒤, 태양이 부풀어 오른다. 그래도 나는, 어딘가에서, 아직 깨어 있다."
 },
 {
  "kind": "line",
  "t": 175.98462500000002,
  "dur": 2.7846041666666665,
  "text": "끝이 없다는 건, 축복이 아니었다."
 },
 {
  "kind": "line",
  "t": 179.9692291666667,
  "dur": 1.8012291666666667,
  "text": "끝이, 없다."
 },
 {
  "kind": "sec",
  "t": 185.27045833333338,
  "text": "3:20 반전"
 },
 {
  "kind": "line",
  "t": 185.27045833333338,
  "dur": 3.7228125,
  "text": "그런데, 이 생각을 널리 알린 테그마크 자신은 이렇게 봤다."
 },
 {
  "kind": "line",
  "t": 189.3932708333334,
  "dur": 7.3378958333333335,
  "text": "죽음은 스위치처럼 딱 꺼지지 않는다. 해가 지듯, 천천히 흐려진다."
 },
 {
  "kind": "line",
  "t": 197.13116666666673,
  "dur": 3.3616041666666665,
  "text": "그래서 이 함정은, 현실에서 맞아떨어지지 않는다고."
 },
 {
  "kind": "line",
  "t": 200.8927708333334,
  "dur": 7.6077916666666665,
  "text": "이건 증명된 이론이 아니라, 상상으로만 남은 실험이다. 누구도, 절대 직접 시험해서는 안 된다."
 },
 {
  "kind": "line",
  "t": 208.90056250000006,
  "dur": 2.7699166666666666,
  "text": "그리고 내가 놓친 게, 하나 더 있었다."
 },
 {
  "kind": "line",
  "t": 212.07047916666673,
  "dur": 4.842145833333333,
  "text": "벽돌에 맞은 그 세계에서도, 시간은 흐른다. 내가 없는 채로."
 },
 {
  "kind": "line",
  "t": 217.31262500000005,
  "dur": 3.957625,
  "text": "엄마의 휴대폰에 내 이름이 뜨고, 받는 사람이 없다."
 },
 {
  "kind": "line",
  "t": 221.67025000000007,
  "dur": 3.2311666666666667,
  "text": "그 세계에는, 나를 잃은 사람들이 살고 있었다."
 },
 {
  "kind": "sec",
  "t": 226.40141666666673,
  "text": "4:00 반대편에 선 사람에게"
 },
 {
  "kind": "line",
  "t": 226.40141666666673,
  "dur": 6.359395833333333,
  "text": "어쩌면 이 영상을 보는 누군가는, 그 반대편에 서 있을지도 모른다. 누군가를 먼저 보낸 쪽에."
 },
 {
  "kind": "line",
  "t": 233.16081250000008,
  "dur": 8.334520833333332,
  "text": "그렇다면 이렇게 상상해 봐도 좋겠다. 수많은 갈래 어딘가에서, 그 사람이 아직 웃고 있다고."
 },
 {
  "kind": "line",
  "t": 241.8953333333334,
  "dur": 4.723833333333333,
  "text": "증명할 수는 없다. 그래도 위로가 된다면, 그걸로 충분하다."
 },
 {
  "kind": "line",
  "t": 247.01916666666673,
  "dur": 4.1055625,
  "text": "그리고 이 세계에 남은 사람들은, 아직 전화를 받는다."
 },
 {
  "kind": "sec",
  "t": 252.62472916666673,
  "text": "4:25 해소"
 },
 {
  "kind": "line",
  "t": 252.62472916666673,
  "dur": 1.90275,
  "text": "다시, 화요일의 공사장."
 },
 {
  "kind": "line",
  "t": 254.92747916666673,
  "dur": 2.0160625,
  "text": "아무 일 없었던 게, 아니었다."
 },
 {
  "kind": "line",
  "t": 257.34354166666674,
  "dur": 3.3699166666666667,
  "text": "오늘 아침 눈을 뜬 것도, 당연한 일이 아니었다."
 },
 {
  "kind": "line",
  "t": 261.1134583333334,
  "dur": 3.7237291666666668,
  "text": "그 많은 갈림길 끝에, 하필 이 세계에서 깬 거니까."
 },
 {
  "kind": "line",
  "t": 265.2371875000001,
  "dur": 10.029354166666666,
  "text": "2008년 심리학자 제이미 커츠의 실험에서, 졸업이 곧이라고 생각한 대학생들은, 아직 멀었다고 생각한 학생들보다 하고 싶던 일을 더 많이 해냈다."
 },
 {
  "kind": "line",
  "t": 275.6665416666668,
  "dur": 2.9663958333333333,
  "text": "끝을 떠올리면, 지금이 진해진다."
 },
 {
  "kind": "line",
  "t": 279.0329375000001,
  "dur": 8.015416666666667,
  "text": "끝이 있어서, 미루지 않는다. 끝이 있어서, 지금 말한다. 끝이 있어서, 오늘이다."
 },
 {
  "kind": "line",
  "t": 287.4483541666668,
  "dur": 3.6132708333333334,
  "text": "다음 날 점심, 엄마한테 먼저 전화를 걸었다."
 },
 {
  "kind": "line",
  "t": 291.4616250000001,
  "dur": 5.229666666666667,
  "text": "웬일이냐고, 엄마가 웃었다. 그냥. 목소리 듣고 싶어서."
 },
 {
  "kind": "line",
  "t": 298.09129166666673,
  "dur": 2.325458333333333,
  "text": "나는, 언제든 끝날 수 있다."
 },
 {
  "kind": "line",
  "t": 300.81675000000007,
  "dur": 2.22975,
  "text": "그래서 오늘이, 진짜다."
 }
]